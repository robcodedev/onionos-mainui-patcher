+static bool themeListRescaleEnabled(void)
+{
+    int enabled = 1;
+
+    if (!config_get(THEME_LIST_RESCALE_CONFIG, CONFIG_INT, &enabled))
+        return true;
+
+    return enabled != 0;
+}
+
+static void rescaleThemeListAssets(const char *theme_path)
+{
+    if (!themeListRescaleEnabled())
+        return;
+    if (access(THEME_LIST_RESCALE_SCRIPT, R_OK) != 0)
+        return;
+
+    int rows = themeListRows();
+    int max_height = 360 / rows;
+    char height_arg[16];
+    char rows_arg[16];
+
+    snprintf(height_arg, sizeof(height_arg), "%d", max_height);
+    snprintf(rows_arg, sizeof(rows_arg), "%d", rows);
+
+    pid_t pid = fork();
+    if (pid < 0) {
+        printf_debug("Could not start theme list resizer: %s\n",
+                     strerror(errno));
+        return;
+    }
+
+    if (pid == 0) {
+        execl("/bin/sh", "sh", THEME_LIST_RESCALE_SCRIPT, theme_path,
+              height_arg, rows_arg, (char *)NULL);
+        _exit(127);
+    }
+
+    int status = 0;
+    while (waitpid(pid, &status, 0) < 0) {
+        if (errno == EINTR)
+            continue;
+        printf_debug("Could not wait for theme list resizer: %s\n",
+                     strerror(errno));
+        return;
+    }
+
+    if (!WIFEXITED(status) || WEXITSTATUS(status) != 0)
+        printf_debug("Theme list resizer failed: %d\n", status);
+}
